# Copy to .env (repo root) for local development: cp .env.example .env
# In production these are set in the server's .env used by Docker Compose (see DEPLOY.md).
# Never commit a real .env.

# ---------------------------------------------------------------------------------------
# Production only (docker-compose.prod.yml). Not needed for local development.
# ---------------------------------------------------------------------------------------

# Your domain, without https:// (e.g. tasks.example.com). Caddy gets the HTTPS certificate for it,
# and the app's public origin becomes https://$DOMAIN.
DOMAIN=
# Email for Let's Encrypt (certificate expiry notices).
ACME_EMAIL=
# Password for the PostgreSQL "todo" user. Use letters and digits only: openssl rand -hex 24
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------------------
# App settings. In production NODE_ENV, HOST, PORT, DATABASE_URL and WEB_ORIGIN are set by
# docker-compose.prod.yml, so leave them out of the server's .env.
# ---------------------------------------------------------------------------------------

# development | test | production. Controls logging format, cookie security, etc.
NODE_ENV=development

# Address the API listens on. 127.0.0.1 locally; the production container uses 0.0.0.0.
HOST=127.0.0.1
# Port the API listens on.
PORT=3000

# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# PostgreSQL connection string used by the API and Prisma migrations.
# Local default matches docker-compose.yml.
DATABASE_URL=postgresql://todo:todo@localhost:5432/todo

# Optional: database for automated tests. Defaults to the todo_test database
# created by docker/postgres-init.
# TEST_DATABASE_URL=postgresql://todo:todo@localhost:5432/todo_test

# Public origin of the app (scheme + host + port). The web app and API share it
# (Vite proxies /api locally; Caddy in production). Used for CORS, auth cookies,
# and links in emails. Production example: https://tasks.example.com
WEB_ORIGIN=http://localhost:5173

# Secret used to sign session cookies and tokens. Required, at least 32 characters.
# Generate one with: openssl rand -base64 48
#   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
BETTER_AUTH_SECRET=

# Email via Gmail SMTP. SMTP_USER is your Gmail address; SMTP_PASS is a Google
# "app password" (Google Account -> Security -> 2-Step Verification -> App passwords),
# NOT your normal password. Required in production. When empty in development,
# emails are printed to the API log instead of being sent.
SMTP_USER=
SMTP_PASS=
# Optional "From" header, e.g. "NIKU <you@gmail.com>". Defaults to "NIKU <SMTP_USER>".
MAIL_FROM=

# Web Push (VAPID) keys. Generate a pair with:  pnpm --filter @todo/api vapid:generate
# Required in production; when empty in development, push notifications are disabled.
# Keep the private key secret. Changing the keys invalidates existing browser subscriptions.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services (your email), e.g. mailto:you@example.com
VAPID_SUBJECT=mailto:you@example.com
