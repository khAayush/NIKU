# Serves the web app and proxies the API, with automatic HTTPS for {$DOMAIN}.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip

	# Larger bodies are rejected before reaching the API (which also caps JSON at 100 KB).
	request_body {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), payment=(), microphone=(self)"
		-Server
	}

	handle /api/* {
		reverse_proxy api:3000
	}

	# Socket.IO (in-app reminders), including WebSocket upgrades.
	handle /socket.io/* {
		reverse_proxy api:3000
	}

	handle {
		root * /srv
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"

		# Hashed build assets never change; everything else (index.html, sw.js) is revalidated.
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		@notAssets not path /assets/*
		header @notAssets Cache-Control "no-cache"

		# Single-page app: unknown paths serve index.html.
		try_files {path} /index.html
		file_server
	}
}
