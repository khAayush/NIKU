{
  "name": "@todo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --import tsx src/server.ts",
    "start": "node --enable-source-maps dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "vapid:generate": "web-push generate-vapid-keys",
    "build": "node scripts/build.mjs"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/adapter-pg": "~7.10.1",
    "@prisma/client": "~7.10.1",
    "@todo/shared": "workspace:*",
    "better-auth": "^1.7.10",
    "chrono-node": "^2.10.3",
    "fastify": "^5.12.7",
    "luxon": "^3.7.2",
    "nodemailer": "^10.1.2",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "pino": "^10.4.0",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "^3.7.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "prisma": "~7.10.1",
    "socket.io-client": "^4.8.4",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
